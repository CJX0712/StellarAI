  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {},
  "optionalDependencies": {
    "@huggingface/transformers": "^3.0.0",
    "hnswlib-node": "^3.0.0"
  },
  "devDependencies": {
    "eslint": "^9.0.0"
  }
}
